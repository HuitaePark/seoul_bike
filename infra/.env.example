# 로컬 실행용. 서버 ~/seoul-bike/.env는 배포가 GitHub production 환경 secret·variable로 만든다 (infra/README "비밀값").
# 저장소에 실제 값을 커밋하지 않는다.
POSTGRES_DB=seoulbike
POSTGRES_USER=seoulbike
POSTGRES_PASSWORD=change-me

VECTOR_DB=seoulbike_vector
VECTOR_USER=seoulbike
VECTOR_PASSWORD=change-me

# 32바이트 이상. 서버에서는 openssl rand -hex 32로 만든다.
JWT_SECRET=change-me-to-at-least-32-bytes-random-string
# 시연 계정(manager, driver1, driver2, executive) 비밀번호. 비우면 계정을 만들지 않는다.
SEED_USER_PASSWORD=change-me
# backend 안의 가짜 에이전트. compose에 진짜 agent가 함께 뜨므로 꺼 둔다 (켜면 둘 다 답해 이벤트가 두 번 나간다).
FAKE_AGENT_ENABLED=false

# business-mcp가 backend /internal/**를 부를지(http) 가짜 응답을 쓸지(fake). backend가 /internal을 열면 http로 바꾼다.
MCP_INTERNAL_MODE=fake
# business-mcp가 /internal/** 호출에 붙이는 서비스 토큰 (X-Internal-Token). backend와 같은 값을 쓴다.
INTERNAL_TOKEN=

# agent: 비우면 harness.yaml 모델, none이면 LLM 없는 경로만 (키 불필요), ollama:<모델>·openai:<모델>이면 그 모델
# 서버는 AGENT_LLM=openai:gpt-4.1-mini (GitHub production 환경 variable)
AGENT_LLM=
OPENAI_API_KEY=
# agent: Ollama Cloud (D25). 키는 ollama.com 설정에서 발급
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=change-me
# agent: 1이면 평가용 가짜 MCP (예시 데이터, backend는 바뀌지 않는다). 시연은 0으로 실제 business-mcp·rag-mcp를 쓴다
MCP_FAKE=0
MCP_BUSINESS_URL=http://business-mcp:9101/mcp
MCP_RAG_URL=http://rag-mcp:9102/mcp

# optimizer(경로 계산 worker)는 .env 값을 쓰지 않는다. 설정(브로커·group-id·하버사인 이동 시간)은 compose.yaml에 고정한다 (infra/README "optimizer")
