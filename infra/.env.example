# 서버에서는 ~/seoul-bike/.env로 복사하고 chmod 600으로 둔다. 저장소에 실제 값을 커밋하지 않는다.
POSTGRES_DB=seoulbike
POSTGRES_USER=seoulbike
POSTGRES_PASSWORD=change-me

VECTOR_DB=seoulbike_vector
VECTOR_USER=seoulbike
VECTOR_PASSWORD=change-me

# 32바이트 이상. 서버에서는 openssl rand -hex 32로 만든다.
JWT_SECRET=change-me-to-at-least-32-bytes-random-string
# 시연 계정(manager, driver1, driver2, executive) 비밀번호. 비우면 계정을 만들지 않는다.
SEED_USER_PASSWORD=change-me
FAKE_AGENT_ENABLED=true

# agent: LLM (D25 Ollama Cloud). 키는 ollama.com 설정에서 발급
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=change-me
# agent: 비우면 harness.yaml 모델, none이면 LLM 없는 경로만 (키 불필요), ollama:<모델>이면 그 모델
AGENT_LLM=
# agent: 1이면 평가용 가짜 MCP. business-mcp·rag-mcp(3)가 compose에 들어오면 0으로 두고 아래 주소를 쓴다
MCP_FAKE=1
MCP_BUSINESS_URL=http://business-mcp:9101/mcp
MCP_RAG_URL=http://rag-mcp:9102/mcp
# agent 서비스가 함께 뜨면 위 FAKE_AGENT_ENABLED는 false로 둔다 (켜 두면 backend 대역과 agent가 둘 다 답한다)
