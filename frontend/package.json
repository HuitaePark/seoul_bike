{
  "name": "seoul-bike-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b",
    "preview": "vite preview",
    "gen:api": "npx -y openapi-typescript@7.13.0 ../docs/specs/openapi.yaml -o src/shared/api/schema.d.ts",
    "test": "node --experimental-strip-types --test tests/plan-review.test.ts tests/dashboard.test.ts tests/live-feed.test.ts tests/zoom.test.ts tests/agent-log.test.ts tests/style-rules.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "maplibre-gl": "6.15.0",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
